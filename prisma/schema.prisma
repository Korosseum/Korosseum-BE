

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
 
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  provider      String
  providerId    String
  nickname      String?         @unique
  photo         String?
  nicknameIndex Int             @unique  @default(autoincrement())
  emailVerified DateTime?
  image         String?
  role          String?         @default("user")
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post_user post_user[]
  post_like post_like[]
  opinion_like opinion_like[]
  opinion Opinion[]
  post Post[]
  RefreshToken RefreshToken[]
  file File[]
  @@unique([provider, id])
}

model RefreshToken {
  id String @id @default(cuid())
  token String @unique
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
 
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
 
// 토론 주제(방) 정보
model Post {
  id             Int        @id @default(autoincrement()) // 토론 고유 ID
  userId         String
  content        String     // 내용
  sideA          String?    // A의견(선택)
  sideB          String?    // B의견(선택)
  sideC          String?    // C의견(선택)
  sideD          String?    // D의견(선택)
  sideE          String?    // E의견(선택)
  sideF          String?    // F의견(선택)
  sideG          String?    // G의견(선택)
  totalCounts    Int        @default(0) // 총 참여자 수
  totalArguments Int        @default(0) // 총 의견 수
  isActive       Boolean    // 활성화 여부
  createdAt      DateTime   @default(now()) // 생성일
  updatedAt      DateTime   @updatedAt @default(now()) // 수정일
  type           String     @default("debate") // 타입(debate, ...any)
  topic          String     @default("custom") // 토픽
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opinions       Opinion[]  // 토론에 달린 의견(댓글)
  post_user    post_user[] // 토론 참가자 목록(다대다)
  post_like   post_like[] // 토론 좋아요 목록(다대다)

}

model post_like {
  postId Int
  userId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
}

model File{
  id String @id @default(cuid())
  userId String 
  ownerId Int 
  ownerType String // post, comment, opinion ···
  originalName String
  type String
  url String
  size Int
  index Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([ownerId, ownerType, index])
}

// 토론 참가자 중간 테이블(다대다 관계, 역할 포함)
model post_user {
  postId   Int      // 토론 ID
  userId     String   // 유저 ID
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade) // 토론과 연결
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade) // 유저와 연결
  createdAt  DateTime @default(now()) // 생성일
  updatedAt  DateTime @updatedAt // 수정일

  @@id([postId, userId]) // 복합 기본키
}

// 토론 의견(댓글)
model Opinion {
  id        Int      @id @default(autoincrement()) // 의견 고유 ID
  text   String   // 의견 내용
  likes     Int      @default(0) // 좋아요 수
  updatedAt DateTime @updatedAt // 수정일
  createdAt DateTime @default(now()) // 생성일
  userId    String   // 작성자 ID
  postId  Int      // 토론 ID
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) // 작성자와 연결
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade) // 토론과 연결
  opinion_like opinion_like[] // 의견 좋아요 목록(다대다)
}

model opinion_like {
  opinionId Int
  userId String
  opinion Opinion @relation(fields: [opinionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([opinionId, userId])
}
